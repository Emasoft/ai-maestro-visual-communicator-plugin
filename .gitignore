.DS_Store

# Per agent rules: _dev folders for transient artifacts that must never be committed
/docs_dev/
/scripts_dev/
/samples_dev/
/examples_dev/
/tests_dev/
/downloads_dev/
/libs_dev/
/builds_dev/
/reports/
/reports_dev/

# Python bytecode caches and linter/type-checker caches
__pycache__/
*.pyc
.ruff_cache/
.mypy_cache/
.pytest_cache/
.coverage
htmlcov/
.tox/

# Python virtual environments
.venv/
venv/
env/

# Environment files — never commit secrets / API tokens / local config
.env
.env.*
!.env.example

# Janitor runtime state
/.janitor/

# Rechecker plugin runtime state
/.rechecker/

# Claude Code session artefacts (chat history, scheduled crons, lock files).
# Deep form (/.claude/** — NOT a bare /.claude/) so the PROJECT-scope memory
# wiki under .claude/project/memory/ can be re-included via the exception block
# at the end of this file. A bare /.claude/ prunes the whole tree, which makes
# any !.claude/project/memory/** re-include inert (git never descends).
/.claude/**

# tldr CLI runtime state + per-project ignore file
/.tldr/
/.tldrignore

# CodeGraph MCP knowledge-graph index (regenerable SQLite cache)
/.codegraph/

# Mega-Linter runtime artefacts — produced by the lint-security CI job
# (.github/workflows/ci.yml) and locally by `mega-linter-runner`. The
# reports dir is large (per-linter sub-reports + html dashboard) and
# never useful in git.
megalinter-reports/
mega-linter.log

# Vendored library build artefacts — node_modules is huge, dist is
# regenerable via `npm run build` in the vendor dir. Vendored source
# lives under top-level vendor/<lib>/src/ (TRACKED, but not part of
# any plugin distribution — only the built artefact is copied into a
# plugin's scripts/ folder).
vendor/*/node_modules/
vendor/*/dist/
vendor/*/dist-bundle/
vendor/*/bun.lock
# Bare top-level node_modules/ in case a future tool runs `npm install`
# at the repo root. Without this, the canonical `vendor/*/node_modules/`
# above only catches subdirectories — a top-level node_modules would
# slip past `git status`.
node_modules/

# ---------------------------------------------------------------------------
# CPV-compatibility duplicates (DO NOT REMOVE)
# ---------------------------------------------------------------------------
# claude-plugins-validation v2.65.x has a bug in `is_path_gitignored`
# (cpv_validation_common.py:4101) where anchored directory patterns of the
# form `/foo/` and globbed directory patterns like `vendor/*/node_modules/`
# fail to match descendant files. The patterns above are the canonical git
# spelling; the entries below are the CPV-compatible spellings that
# satisfy CPV's bugged matcher AND are no-ops for real git (git already
# ignores the descendants via the canonical patterns above, so these
# duplicates do not change the repo state — they only feed CPV's [REPO LINT]
# step the strings it needs to skip those trees).
# When CPV ships a fix for `is_path_gitignored`, this entire block can be
# removed.
/docs_dev/**
/scripts_dev/**
/samples_dev/**
/examples_dev/**
/tests_dev/**
/downloads_dev/**
/libs_dev/**
/builds_dev/**
/reports/**
/reports_dev/**
/.janitor/**
/.rechecker/**
/.claude/**
/.tldr/**
/.codegraph/**
**/node_modules/**
**/dist/**

# ---------------------------------------------------------------------------
# PROJECT-scope memory wiki (janitor wikimem) — MUST be tracked + pushed
# ---------------------------------------------------------------------------
# The PROJECT memory scope lives in-repo under .claude/project/memory/ and is the
# shared, cross-dev memory wiki (see the janitor's /janitor-memory-bootstrap and
# ~/.claude/rules/markdown-memory-recall.md). These exceptions re-include it past
# the /.claude/** ignores above — order matters: re-include each parent dir
# first, then the whole subtree. The bare /.claude/ above was widened to
# /.claude/** precisely so these re-includes take effect.
!.claude/project/
!.claude/project/memory/
!.claude/project/memory/**
