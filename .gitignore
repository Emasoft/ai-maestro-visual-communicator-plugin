.DS_Store

# Per agent rules: _dev folders for transient artifacts that must never be committed
/docs_dev/
/scripts_dev/
/samples_dev/
/examples_dev/
/tests_dev/
/downloads_dev/
/libs_dev/
/builds_dev/
/reports/
/reports_dev/

# Python bytecode caches and linter/type-checker caches
__pycache__/
*.pyc
.ruff_cache/
.mypy_cache/
.pytest_cache/
.coverage
htmlcov/
.tox/

# Python virtual environments
.venv/
venv/
env/

# Janitor runtime state
/.janitor/

# Rechecker plugin runtime state
/.rechecker/

# Claude Code session artefacts (chat history, scheduled crons, lock files)
/.claude/

# tldr CLI runtime state + per-project ignore file
/.tldr/
/.tldrignore

# Vendored library build artefacts — node_modules is huge, dist is
# regenerable via `npm run build` in the vendor dir. Vendored source
# lives under top-level vendor/<lib>/src/ (TRACKED, but not part of
# any plugin distribution — only the built artefact is copied into a
# plugin's scripts/ folder).
vendor/*/node_modules/
vendor/*/dist/
# Bare top-level node_modules/ in case a future tool runs `npm install`
# at the repo root. Without this, the canonical `vendor/*/node_modules/`
# above only catches subdirectories — a top-level node_modules would
# slip past `git status`.
node_modules/

# ---------------------------------------------------------------------------
# CPV-compatibility duplicates (DO NOT REMOVE)
# ---------------------------------------------------------------------------
# claude-plugins-validation v2.65.x has a bug in `is_path_gitignored`
# (cpv_validation_common.py:4101) where anchored directory patterns of the
# form `/foo/` and globbed directory patterns like `vendor/*/node_modules/`
# fail to match descendant files. The patterns above are the canonical git
# spelling; the entries below are the CPV-compatible spellings that
# satisfy CPV's bugged matcher AND are no-ops for real git (git already
# ignores the descendants via the canonical patterns above, so these
# duplicates do not change the repo state — they only feed CPV's [REPO LINT]
# step the strings it needs to skip those trees).
# When CPV ships a fix for `is_path_gitignored`, this entire block can be
# removed.
/docs_dev/**
/scripts_dev/**
/samples_dev/**
/examples_dev/**
/tests_dev/**
/downloads_dev/**
/libs_dev/**
/builds_dev/**
/reports/**
/reports_dev/**
/.janitor/**
/.rechecker/**
/.claude/**
/.tldr/**
**/node_modules/**
**/dist/**
