{
  "name": "ve-pierre-diffs-vendor",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Vendored Pierre diff viewer (derived from @pierre/diffs 1.2.1, Apache-2.0). Builds a single browser-loadable ESM bundle for the ai-maestro-visual-communicator plugin.",
  "license": "Apache-2.0",
  "sideEffects": [
    "src/components/web-components.ts"
  ],
  "scripts": {
    "build": "tsdown --clean",
    "build:bundle": "node ./scripts/bundle.mjs"
  },
  "dependencies": {
    "@pierre/theme": "0.0.29",
    "@shikijs/transformers": "4.0.2",
    "diff": "8.0.3",
    "hast-util-to-html": "9.0.5",
    "lru_map": "0.4.1",
    "shiki": "4.0.2"
  },
  "devDependencies": {
    "@types/hast": "3.0.4",
    "autoprefixer": "10.4.22",
    "esbuild": "0.25.10",
    "lightningcss": "1.32.0",
    "postcss": "8.5.6",
    "postcss-calc": "10.1.1",
    "postcss-nesting": "14.0.0",
    "tsdown": "0.15.11",
    "typescript": "5.9.2"
  }
}
