#!/usr/bin/env python3
"""Pre-push hook for ai-maestro-visual-communicator.

Delegator to ``scripts/publish.py --gate`` with two CRITICAL hardening
layers borrowed from the canonical CPV-self hook at
~/.claude/plugins/cache/emasoft-plugins/claude-plugins-validation/2.94.0/git-hooks/pre-push
(see canonical-pipeline-migration step 9, doctor report D6-003):

1. **Process-ancestry verification** — walks the process tree via `ps`
   to confirm that ``scripts/publish.py`` from THIS repo is an ancestor
   of the ``git push`` call. Env vars are trivially spoofable
   (``CPV_PUBLISH_PIPELINE=1 git push`` bypasses); process ancestry is
   not. Direct ``git push`` is rejected with a loud error pointing the
   user at the right entry point.

2. **Tag-vs-version validation for tag-only pushes** — when the user
   pushes only a tag (``git push origin v1.2.3``), the canonical gate
   logic (G1 in publish.py) compares local plugin.json version vs
   latest remote tag, which is meaningless for a tag-only push (the
   tag IS the thing being created). Instead, verify the tag is one of
   the refs publish.py mints for THIS version — ``v{version}`` or its
   resolver twin ``{name}--v{version}`` — so tags and manifest stay in
   lockstep. One additional legitimate shape is accepted, fail-closed:
   a resolver-twin BACKFILL of an already-released historical version
   (``{name}--v<version>`` whose ``v<version>`` tag exists locally),
   because publish.py::_push_resolver_backfill() tag-only-pushes those
   twins after every successful release.

The 4 quality gates still run in order after these two checks pass; any
failure blocks the push:

  G1  Version-bump check (local plugin.json vs latest remote tag)
  G2  Lint (`ruff check scripts/`)
  G3  Validate plugin (cpv-remote-validate plugin . --strict)
  G4  Dev-browser test suite (soft-pass on missing CLI)

To install (idempotent — safe to re-run):
  uv run python scripts/publish.py --install-hook

Or, to wire it manually:
  git config core.hooksPath git-hooks

Bypass (only for emergency hotfixes — leaves a forensic trail):
  git push --no-verify
"""
from __future__ import annotations

import json
import os
import subprocess
import sys
from pathlib import Path

# git pre-push hook stdin format: LOCAL_REF LOCAL_SHA REMOTE_REF REMOTE_SHA
# The all-zeros SHA indicates branch/tag deletion in git hooks.
ZERO_SHA = "0000000000000000000000000000000000000000"


# ─── Helpers ─────────────────────────────────────────────────────────────────


def _repo_root() -> Path:
    """Resolve the repo root via ``git rev-parse --show-toplevel``."""
    result = subprocess.run(
        ["git", "rev-parse", "--show-toplevel"],
        capture_output=True,
        text=True,
        check=True,
    )
    return Path(result.stdout.strip())


def _has_uv() -> bool:
    """Return True iff ``uv`` is on PATH."""
    from shutil import which

    return which("uv") is not None


def _get_process_ancestry(max_depth: int = 30) -> list[tuple[int, str]]:
    """Walk the process tree from this process up to PID 1.

    Returns a list of (pid, command_line) tuples from closest ancestor
    to root. Uses ``ps`` which is available on macOS, Linux, and BSD.
    Returns an empty list if the walk fails (caller treats as fail-closed).
    """
    ancestry: list[tuple[int, str]] = []
    pid = os.getpid()
    seen: set[int] = set()
    for _ in range(max_depth):
        if pid in seen or pid <= 0:
            break
        seen.add(pid)
        try:
            result = subprocess.run(
                ["ps", "-p", str(pid), "-o", "ppid=,args="],
                capture_output=True,
                text=True,
                timeout=5,
            )
        except (OSError, subprocess.SubprocessError):
            return []
        if result.returncode != 0:
            break
        line = result.stdout.strip()
        if not line:
            break
        parts = line.split(None, 1)
        if not parts:
            break
        try:
            ppid = int(parts[0])
        except ValueError:
            break
        cmdline = parts[1] if len(parts) > 1 else ""
        ancestry.append((pid, cmdline))
        if ppid <= 1:
            break
        pid = ppid
    return ancestry


def _called_by_publish_py(repo_root: Path) -> bool:
    """Check if any ancestor process is the publish.py script from this repo.

    Uses process ancestry (not env vars) — env vars are trivially
    spoofable, process ancestry is not. Walks the process tree via ``ps``
    and verifies that ``scripts/publish.py`` from THIS repository is an
    ancestor of the current hook invocation.

    The expected chain is::

        publish.py → git push → git (pre-push hook)
    """
    ancestry = _get_process_ancestry()
    if not ancestry:
        return False

    expected_path = str((repo_root / "scripts" / "publish.py").resolve())
    expected_basename = "scripts/publish.py"

    for _pid, cmdline in ancestry:
        if "publish.py" not in cmdline:
            continue
        # Strict match: the absolute path of THIS repo's publish.py must be
        # in the command line, OR the path component "scripts/publish.py"
        # must be present (cwd-relative invocation pattern).
        if expected_path in cmdline or expected_basename in cmdline:
            return True
    return False


def _extract_local_version(repo_root: Path) -> str | None:
    """Return the ``version`` field from .claude-plugin/plugin.json, or None."""
    plugin_json = repo_root / ".claude-plugin" / "plugin.json"
    try:
        data = json.loads(plugin_json.read_text(encoding="utf-8"))
        version = data.get("version")
        return version if isinstance(version, str) else None
    except (FileNotFoundError, json.JSONDecodeError, OSError):
        return None


def _extract_plugin_name(repo_root: Path) -> str | None:
    """Return the ``name`` field from .claude-plugin/plugin.json, or None.

    Read from the manifest — NEVER hardcoded — because it is the prefix of
    the resolver tag ``{name}--v{version}``. publish.py derives that prefix
    the same way (``_plugin_name()``), so reading the same field from the
    same file is what keeps this hook and the publisher from desyncing if
    the plugin is ever renamed.
    """
    plugin_json = repo_root / ".claude-plugin" / "plugin.json"
    try:
        data = json.loads(plugin_json.read_text(encoding="utf-8"))
        name = data.get("name")
        return name if isinstance(name, str) and name else None
    except (FileNotFoundError, json.JSONDecodeError, OSError):
        return None


def _local_tag_exists(tag: str) -> bool:
    """Return True iff ``tag`` exists in the local repository.

    FAIL-CLOSED by construction: any failure to run git (missing binary,
    timeout, OS error) counts as "does not exist", so a tag that cannot
    be verified is never accepted.
    """
    try:
        result = subprocess.run(
            ["git", "rev-parse", "-q", "--verify", f"refs/tags/{tag}"],
            capture_output=True,
            timeout=10,
        )
    except (OSError, subprocess.SubprocessError):
        return False
    return result.returncode == 0


def _is_resolver_backfill_twin(tag: str, plugin_name: str | None) -> bool:
    """True iff ``tag`` is a legitimate resolver-twin BACKFILL ref.

    WHY this exists: publish.py::_push_resolver_backfill()
    (scripts/publish.py:758) runs AFTER a successful release push and
    tag-only-pushes the resolver twins ``{name}--v<version>`` of every
    ALREADY-RELEASED historical version, so that version-constrained
    dependents can resolve old releases too. Those twins are not the
    current manifest version, so without this clause the tag-vs-version
    guard rejected that push and the backfill failed on EVERY publish,
    forever — the historical twins could never reach the remote.

    Acceptance is deliberately narrow (fail-closed):
      * ``plugin_name`` must be readable from the manifest — if it is
        None the answer is always False, i.e. the guard behaves exactly
        as it did before this clause existed (no widening).
      * the tag must have the EXACT form ``{plugin_name}--v<version>``
        (DOUBLE hyphen, non-empty version).
      * the corresponding human tag ``v<version>`` must already exist
        LOCALLY — proving the twin points at a release this repo has
        actually made. A twin for a version never released here (a typo,
        a fabricated version) fails this check and still blocks.
    """
    if not plugin_name:
        return False
    prefix = f"{plugin_name}--v"
    if not tag.startswith(prefix):
        return False
    version = tag[len(prefix):]
    if not version:
        return False
    return _local_tag_exists(f"v{version}")


def _classify_push_refs() -> tuple[list[str], list[str]]:
    """Split stdin push refs into (branch_refs, tag_refs).

    git pre-push hook stdin is one line per pushed ref:
        LOCAL_REF LOCAL_SHA REMOTE_REF REMOTE_SHA

    Classification MUST key on REMOTE_REF (parts[2]), never LOCAL_REF.
    git echoes back whatever the user spelled on the LEFT of the refspec
    as LOCAL_REF, and publish.py pushes
    ``git push --atomic origin HEAD v1.5.0 <name>--v1.5.0`` — so the
    branch line arrives with the literal LOCAL_REF ``HEAD`` (and a
    deletion arrives as ``(delete)``). ``HEAD`` matches neither
    ``refs/heads/`` nor ``refs/tags/``, so keying on it silently DROPPED
    the branch from both lists: ``branch_refs`` came back empty, a
    branch+tags release push was misread as a tag-only push, and the
    tag-vs-version guard below misfired and blocked a valid release.
    REMOTE_REF is always fully qualified by git no matter how the local
    side was spelled, so it is the only reliable discriminator.
    """
    branch_refs: list[str] = []
    tag_refs: list[str] = []
    stdin_lines = sys.stdin.read().strip().splitlines()
    for line in stdin_lines:
        parts = line.split()
        if len(parts) < 4:
            continue
        remote_ref = parts[2]
        if remote_ref.startswith("refs/tags/"):
            tag_refs.append(remote_ref[len("refs/tags/"):])
        elif remote_ref.startswith("refs/heads/"):
            branch_refs.append(remote_ref[len("refs/heads/"):])
    return branch_refs, tag_refs


# ─── Main ────────────────────────────────────────────────────────────────────


def main() -> int:
    """Verify the push is canonical (publish.py + tag-vs-version), then gate."""
    root = _repo_root()
    os.chdir(root)

    # ── Pipeline enforcement: only publish.py may push ──
    # Uses PROCESS ANCESTRY, not env vars. Env vars are trivially spoofable
    # (e.g. CPV_PUBLISH_PIPELINE=1 git push); process ancestry is not. The
    # hook walks its parent chain up to PID 1 via `ps` and requires that
    # scripts/publish.py from THIS repo is an ancestor of the push.
    if not _called_by_publish_py(root):
        print("=" * 40, file=sys.stderr)
        print("  BLOCKED: Direct push not allowed", file=sys.stderr)
        print("  This hook only accepts pushes initiated by", file=sys.stderr)
        print("  scripts/publish.py (verified via process ancestry).", file=sys.stderr)
        print("  Use: uv run python scripts/publish.py --patch --push", file=sys.stderr)
        print("=" * 40, file=sys.stderr)
        return 1

    # ── Tag-vs-version validation for tag-only pushes ──
    # publish.py pushes branch first, then tag (--atomic). At tag-push time
    # the remote master is already at the new version, so G1's "strictly
    # greater" rule would fail. Verify instead that every pushed tag is one
    # of the refs publish.py mints for the local manifest version.
    branch_refs, tag_refs = _classify_push_refs()
    tag_only_push = bool(tag_refs) and not branch_refs

    if tag_only_push:
        local_version = _extract_local_version(root)
        if local_version is not None:
            # A release carries TWO legitimate refs for the same version, and
            # both are pushed in one atomic transaction by publish.py's
            # _release_tags(): the human-readable `v{version}` AND the
            # resolver twin `{name}--v{version}` (DOUBLE hyphen), which is the
            # only form Claude Code's version-constrained dependency resolver
            # will match. Accepting only `v{version}` meant publish.py's own
            # release push was rejected by the hook publish.py installs.
            # Anything that is neither form still BLOCKS — a genuinely wrong
            # tag (a stale version, a typo) is as fatal as it ever was.
            expected_tags = [f"v{local_version}"]
            plugin_name = _extract_plugin_name(root)
            if plugin_name:
                expected_tags.append(f"{plugin_name}--v{local_version}")
            # A tag is legitimate iff it is (a) one of the current-version
            # pair above, or (b) a resolver-twin BACKFILL of an already-
            # released version (see _is_resolver_backfill_twin — needed
            # because publish.py::_push_resolver_backfill() tag-only-pushes
            # historical twins after every successful release; without (b)
            # that backfill failed on every publish forever). One bad tag
            # blocks the WHOLE push — fail-closed.
            mismatched = [
                t
                for t in tag_refs
                if t not in expected_tags
                and not _is_resolver_backfill_twin(t, plugin_name)
            ]
            if mismatched:
                print("=" * 40, file=sys.stderr)
                print("  BLOCKED: Tag name does not match plugin version!", file=sys.stderr)
                print(f"  Pushed tag(s): {', '.join(mismatched)}", file=sys.stderr)
                print(f"  Expected one of: {', '.join(expected_tags)}", file=sys.stderr)
                print(
                    "  (or a resolver-twin backfill "
                    f"{plugin_name or '<plugin-name>'}--v<version> whose "
                    "v<version> tag already exists locally)",
                    file=sys.stderr,
                )
                print("  Run: uv run python scripts/publish.py --patch", file=sys.stderr)
                print("=" * 40, file=sys.stderr)
                return 1
            print(
                "[pre-push] Tag(s) accepted (current version or verified "
                f"backfill twin): {', '.join(tag_refs)}",
                flush=True,
            )
        else:
            print(
                "[pre-push] WARNING: cannot extract local version — skipping tag check",
                file=sys.stderr,
            )

    # ── Delegate to publish.py --gate (G1-G4) ──
    publish = root / "scripts" / "publish.py"
    if not publish.is_file():
        # Fail safe — without publish.py we cannot enforce the canonical
        # gate. Refuse the push so the user re-installs the script.
        print("[pre-push] FATAL: scripts/publish.py is missing", file=sys.stderr)
        return 1

    # Delegate via the same interpreter that runs the hook. ``uv run``
    # is preferred when available (matches CI); otherwise fall back to the
    # current interpreter so the hook remains usable in vanilla Python
    # environments (e.g. fresh clone with no uv installed).
    cmd: list[str]
    if _has_uv():
        cmd = ["uv", "run", "--python", "3.12", "python", str(publish), "--gate"]
    else:
        cmd = [sys.executable, str(publish), "--gate"]

    return subprocess.run(cmd, check=False).returncode


if __name__ == "__main__":
    raise SystemExit(main())
