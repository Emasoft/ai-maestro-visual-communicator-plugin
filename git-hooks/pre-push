#!/usr/bin/env python3
"""Pre-push hook for ai-maestro-visual-communicator.

Thin delegator to ``scripts/publish.py --gate``. The gate logic lives in
``publish.py`` so the pre-push hook, the publish-mode S2-S4 stages, and any
ad-hoc CI invocation all share **one** source of truth.

To install (idempotent — safe to re-run):
  uv run python scripts/publish.py --install-hook

Or, to wire it manually:
  git config core.hooksPath .githooks

The 4 gates run in order; any failure blocks the push:
  G1  Version-bump check (local plugin.json vs latest remote tag)
  G2  Lint (`ruff check scripts/`)
  G3  Validate plugin (cpv-remote-validate plugin . --strict)
  G4  Dev-browser test suite (soft-pass on missing CLI)

Bypass (only for emergency hotfixes — leaves a forensic trail):
  git push --no-verify
"""
from __future__ import annotations

import os
import subprocess
import sys
from pathlib import Path


def _repo_root() -> Path:
    """Resolve the repo root via ``git rev-parse --show-toplevel``."""
    result = subprocess.run(
        ["git", "rev-parse", "--show-toplevel"],
        capture_output=True,
        text=True,
        check=True,
    )
    return Path(result.stdout.strip())


def main() -> int:
    """Cd to repo root, then exec ``publish.py --gate``."""
    root = _repo_root()
    os.chdir(root)

    publish = root / "scripts" / "publish.py"
    if not publish.is_file():
        # Fail safe — without publish.py we cannot enforce the canonical
        # gate. Refuse the push so the user re-installs the script.
        print("[pre-push] FATAL: scripts/publish.py is missing", file=sys.stderr)
        return 1

    # We delegate via the same interpreter that runs the hook. ``uv run``
    # is preferred when available (matches CI); otherwise fall back to the
    # current interpreter so the hook remains usable in vanilla Python
    # environments (e.g. fresh clone with no uv installed).
    cmd: list[str]
    if _has_uv():
        cmd = ["uv", "run", "--python", "3.12", "python", str(publish), "--gate"]
    else:
        cmd = [sys.executable, str(publish), "--gate"]

    return subprocess.run(cmd, check=False).returncode


def _has_uv() -> bool:
    """Return True iff ``uv`` is on PATH."""
    from shutil import which

    return which("uv") is not None


if __name__ == "__main__":
    raise SystemExit(main())
